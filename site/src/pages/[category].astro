---
import { getAllSections } from '../lib/readme';
import PostHog from '../components/posthog.astro';
import Analytics from '../components/analytics.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

export function getStaticPaths() {
  return getAllSections().map(({ slug, title, html }) => ({
    params: { category: slug },
    props: { title, html },
  }));
}

const { category } = Astro.params;
const { title, html } = Astro.props;

const SITE_URL = 'https://samber.github.io/awesome-ai-native/';
const BASE = '/awesome-ai-native/';
const canonicalUrl = `${SITE_URL}${category}/`;

// Per-category SEO metadata targeting real search queries.
const META: Record<string, { pageTitle: string; description: string }> = {
  'chat-agents': {
    pageTitle: 'Best AI Chat Apps & Agents (2026) — ChatGPT, Claude, Gemini | Awesome AI-Native',
    description:
      'Curated list of AI chat assistants and general-purpose agents: ChatGPT, Claude, Gemini, Grok, Manus, and self-hosted personal AI agents and computer-use models.',
  },
  'vibe-coding-and-vibe-engineering': {
    pageTitle: 'Best AI Coding Agents & Tools (2026) — Cursor, Claude Code | Awesome AI-Native',
    description:
      'Curated list of AI coding agents, code understanding and docs tools, and AI app builders for vibe-coding and vibe-engineering.',
  },
  'knowledge-work': {
    pageTitle: 'AI Tools for Knowledge Work — Search, Notes, Meetings | Awesome AI-Native',
    description:
      'AI-native tools for knowledge work: AI search and research, knowledge management, and meeting and voice assistants that transcribe, summarize, and act.',
  },
  'industry-applications': {
    pageTitle: 'AI Products by Industry — Support, Sales, Legal, Health | Awesome AI-Native',
    description:
      'AI-native products for specific industries: customer support, sales and CRM, legal, healthcare, and education, where an LLM is the core of the product.',
  },
  'creative-media': {
    pageTitle: 'Best AI Creative & Media Tools (2026) — Image, Video, Audio | Awesome AI-Native',
    description:
      'Curated list of AI creative tools: design, image generation, video generation, and audio and music models for creators and studios.',
  },
  'models-robotics': {
    pageTitle: 'Open-Weight Models, SLMs & AI Robotics | Awesome AI-Native',
    description:
      'Curated list of open-weight large language models, small language models, robotics and embodied AI, and OCR models for builders.',
  },
  'compute-infrastructure': {
    pageTitle: 'AI Compute & Infrastructure — Chips, Inference, Sandboxes | Awesome AI-Native',
    description:
      'AI compute and infrastructure: AI chips and hardware, local inference engines, GPU clouds, hosted inference and fine-tuning, serving and orchestration, gateways, and code sandboxes for AI agents.',
  },
  'developer-tooling': {
    pageTitle: 'AI Developer Tools — Frameworks, MCP, Vector DBs, Evals | Awesome AI-Native',
    description:
      'Curated list of AI developer tooling: agent frameworks and SDKs, MCP and integrations, vector databases and retrieval, agent memory, and evaluation and observability.',
  },
  'learning-community': {
    pageTitle: 'AI Learning & Community — Newsletters, Podcasts, Papers | Awesome AI-Native',
    description:
      'Learn and connect: AI newsletters and blogs, podcasts, people to follow, courses, foundational papers, events, and communities.',
  },
};

const meta = META[category] ?? {
  pageTitle: `${title} | Awesome AI-Native`,
  description: `Curated list of ${title} tools and resources in the AI-native ecosystem.`,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: meta.pageTitle,
  description: meta.description,
  url: canonicalUrl,
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', url: SITE_URL, name: 'Awesome AI-Native' },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Awesome AI-Native', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: title, item: canonicalUrl },
    ],
  },
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.pageTitle}</title>
    <meta name="description" content={meta.description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <link rel="sitemap" type="application/xml" href={`${BASE}sitemap.xml`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Awesome AI-Native" />
    <meta property="og:title" content={meta.pageTitle} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${SITE_URL}og-image.svg`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@samuelberthe" />
    <meta name="twitter:title" content={meta.pageTitle} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={`${SITE_URL}og-image.svg`} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <PostHog />
    <Analytics />
  </head>
  <body>
    <div class="hero" style="padding: 2.5rem 1rem;">
      <div class="hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href={BASE}>Awesome AI-Native</a>
          <span aria-hidden="true"> › </span>
          <span>{title}</span>
        </nav>
        <h1 class="hero-title" style="margin-top: 0.75rem;">
          <span class="hero-title-main">{title}</span>
        </h1>
        <p class="hero-desc">{meta.description}</p>
        <div class="hero-actions" style="margin-top: 1.25rem;">
          <a href={BASE} class="hero-cta" style="font-size: 0.875rem;">
            ← Back to full list
          </a>
        </div>
      </div>
    </div>

    <main class="content">
      <Fragment set:html={html} />
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  .breadcrumb {
    font-size: 0.875rem;
    color: var(--muted-on-dark);
  }
  .breadcrumb a {
    color: var(--muted-on-dark);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--text-on-dark);
    text-decoration: underline;
  }
</style>
