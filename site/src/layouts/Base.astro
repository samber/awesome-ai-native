---
import { execFileSync } from 'node:child_process';
import { resolve } from 'node:path';
import { readFileSync } from 'node:fs';
import PostHog from '../components/posthog.astro';
import Analytics from '../components/analytics.astro';
import Ahrefs from '../components/ahrefs.astro';
import GithubCta from '../components/GithubCta.astro';
import SiteFooter from '../components/SiteFooter.astro';

const SITE_URL = 'https://samber.github.io/awesome-ai-native/';

// Count list items in README to keep numberOfItems accurate at build time.
const readmePath = resolve(process.cwd(), '..', 'README.md');
const readmeText = readFileSync(readmePath, 'utf-8');
const numberOfItems = (readmeText.match(/^- \[/gm) ?? []).length;

// Use last git commit date for dateModified.
let dateModified: string;
try {
  dateModified = execFileSync('git', ['log', '-1', '--format=%cI', '--', '../README.md'], { encoding: 'utf-8' }).trim();
  if (!dateModified) throw new Error('empty');
} catch {
  dateModified = new Date().toISOString();
}
const title = 'Awesome AI-Native – Curated list of AI-native products and tools';
const description =
  'A curated list of AI-native products and resources — where an LLM is the product, not a feature. Chat & agents, coding, knowledge work, creative media, models, infrastructure, and developer tooling.';

const author = {
  '@type': 'Person',
  '@id': `${SITE_URL}#author`,
  name: 'Samuel Berthe',
  url: 'https://github.com/samber',
  sameAs: ['https://github.com/samber'],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}#website`,
      name: 'Awesome AI-Native',
      url: SITE_URL,
      description,
      inLanguage: 'en',
      author: { '@id': `${SITE_URL}#author` },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${SITE_URL}#\${search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'CollectionPage',
      '@id': `${SITE_URL}#page`,
      name: 'Awesome AI-Native',
      headline: title,
      description,
      url: SITE_URL,
      inLanguage: 'en',
      isPartOf: { '@id': `${SITE_URL}#website` },
      author: { '@id': `${SITE_URL}#author` },
      publisher: { '@id': `${SITE_URL}#author` },
      about: {
        '@type': 'Thing',
        name: 'AI-native software',
        description:
          'Products built around a large language model as the core of the experience, rather than an AI feature added to an existing tool.',
        sameAs: 'https://en.wikipedia.org/wiki/Large_language_model',
      },
      keywords: [
        'AI-native',
        'LLM apps',
        'AI agents',
        'coding agents',
        'ChatGPT',
        'Claude',
        'Gemini',
        'Mistral',
        'MCP',
        'RAG',
        'vector database',
        'open-weight models',
        'AI infrastructure',
        'generative AI',
        'AI products',
        'AI tools',
        'agent memory',
        'AI evaluation',
        'local inference',
        'awesome list',
      ],
      numberOfItems,
      dateModified,
      hasPart: [
        { '@type': 'WebPageElement', name: 'Chat & agents', url: `${SITE_URL}#chat--agents` },
        { '@type': 'WebPageElement', name: 'Vibe-coding and vibe-engineering', url: `${SITE_URL}#vibe-coding-and-vibe-engineering` },
        { '@type': 'WebPageElement', name: 'Knowledge work', url: `${SITE_URL}#knowledge-work` },
        { '@type': 'WebPageElement', name: 'Industry applications', url: `${SITE_URL}#industry-applications` },
        { '@type': 'WebPageElement', name: 'Creative & media', url: `${SITE_URL}#creative--media` },
        { '@type': 'WebPageElement', name: 'Models & robotics', url: `${SITE_URL}#models--robotics` },
        { '@type': 'WebPageElement', name: 'Compute & infrastructure', url: `${SITE_URL}#compute--infrastructure` },
        { '@type': 'WebPageElement', name: 'Developer tooling', url: `${SITE_URL}#developer-tooling` },
        { '@type': 'WebPageElement', name: 'Learning & community', url: `${SITE_URL}#learning--community` },
      ],
    },
    author,
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Samuel Berthe" />
    <link rel="canonical" href={SITE_URL} />

    <!-- Google Search Console ownership proof for the URL-prefix property. Removing it un-verifies the property. -->
    <meta name="google-site-verification" content="0eAhRs43bpa9oRa-zAVjWLYK93eKcZZztlnF3Vq_4BE" />
    <link rel="icon" type="image/svg+xml" href="/awesome-ai-native/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/awesome-ai-native/sitemap.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Awesome AI-Native" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:image" content={`${SITE_URL}og-image.svg`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@samuelberthe" />
    <meta name="twitter:creator" content="@samuelberthe" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}og-image.svg`} />

    <!-- Keywords -->
    <meta name="keywords" content="AI-native, LLM apps, AI agents, coding agents, ChatGPT, Claude, Gemini, MCP, RAG, vector database, open-weight models, AI infrastructure, generative AI, AI products, AI tools" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <PostHog />
    <Analytics />
    <Ahrefs />
  </head>
  <body>
    <div class="hero">
      <div class="hero-inner">
        <div class="hero-eyebrow">Awesome List</div>
        <h1 class="hero-title">
          <span class="hero-title-main">Awesome AI-Native</span>
        </h1>
        <p class="hero-desc">
          A curated list of AI-native products and resources — where an LLM is the
          product, not a feature. Chat &amp; agents, coding, creative tools, models,
          and infrastructure.
        </p>
        <div class="hero-actions">
          <GithubCta />
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><span class="hero-stat-num">250+</span><span class="hero-stat-label">tools</span></div>
          <div class="hero-stat-sep"></div>
          <div class="hero-stat"><span class="hero-stat-num">40+</span><span class="hero-stat-label">categories</span></div>
          <div class="hero-stat-sep"></div>
          <div class="hero-stat"><span class="hero-stat-num">open</span><span class="hero-stat-label">source</span></div>
        </div>
      </div>
    </div>

    <slot />

    <SiteFooter />
  </body>
</html>
